# ---------------------------------------------------------------------------
# Frontend (web/) – másold .env.local-ba
# ---------------------------------------------------------------------------
# Mindhárom blokk opcionális: kulcsok nélkül az app a repóban lévő
# web/public/data/db.json pillanatképből olvas, és szabályalapú verdiktet ad.

# --- Supabase (adatréteg) --------------------------------------------------
# Ha ez a kettő be van állítva, az app a Supabase-ből olvas a lokális JSON
# helyett. Az anon kulcs publikus, az RLS csak SELECT-et enged rá.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Csak a verdikt-cache írásához kell (ai_verdicts tábla). SOHA ne tedd
# NEXT_PUBLIC_ prefix mögé – ez a kulcs megkerüli az RLS-t.
SUPABASE_SERVICE_ROLE_KEY=

# --- Claude API (AI-verdikt) -----------------------------------------------
# Enélkül a verdikt szabályalapú marad, az app működik.
ANTHROPIC_API_KEY=
# Alapértelmezés: claude-opus-5. Olcsóbb demóhoz: claude-haiku-4-5
ANTHROPIC_MODEL=

# --- Fejlesztés ------------------------------------------------------------
# 1 = a szintetikus demó-ártörténetet mutatja (scraper/seed_demo.py).
# Éles deployon hagyd üresen.
NEXT_PUBLIC_DEMO_DATA=
